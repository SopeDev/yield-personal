# Postgres connection string (Prisma Postgres or Neon via the Vercel integration also sets POSTGRES_URL).
DATABASE_URL=

# Auth.js secret (generate with `npx auth secret`) and Google OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed to sign in.
ALLOWED_EMAILS=

# IANA time zone used to decide what "today" is. Defaults to America/Tijuana.
APP_TIME_ZONE=
