# Postgres connection string (Prisma Postgres or Neon via the Vercel integration also sets POSTGRES_URL).
DATABASE_URL=

# Auth.js secret (generate with `npx auth secret`) and Google OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Key that encrypts amounts, names and notes in the database: 32 random bytes, `openssl rand -base64 32`.
# Keep a copy somewhere safe: without it the data can't be read. Every environment sharing a database needs the same key.
DATA_ENCRYPTION_KEY=

# IANA time zone used to decide what "today" is. Defaults to America/Tijuana.
APP_TIME_ZONE=

# The app owner's email: the only account that can open the setup wizard's preview at /onboarding/preview.
OWNER_EMAIL=
