generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryKind {
  EVERYDAY
  BILLS
  OCCASIONAL

  @@map("category_kind")
}

enum IncomeRhythm {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTH_DAYS

  @@map("income_rhythm")
}

enum PaymentMethodKind {
  CASH
  CARD

  @@map("payment_method_kind")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String?               @map("display_name")
  email                String?               @unique
  emailVerified        DateTime?             @map("email_verified") @db.Timestamptz(6)
  image                String?
  /// The currency headline figures (balance, needed per day, averages) are in (an ISO 4217 code such as "MXN").
  /// Records in other currencies are totalled separately, never converted.
  currency             String                @default("MXN")
  /// Monthly balance goal in centavos: money to have left over or saved each month. Null when unset.
  balanceGoalCents     Int?                  @map("balance_goal_cents")
  /// First month (its first day) counted in calculations from past spending, like averages and typical daily
  /// spending; earlier months may hold only partial records. Null counts every month.
  historyStartMonth    DateTime?             @map("history_start_month") @db.Date
  /// How often income arrives: every day, weekly or every two weeks counted from `incomeRhythmAnchor` (any
  /// payday), or on the days of the month in `incomePayDays`. Sets the paydays the per-payday stats count.
  incomeRhythm         IncomeRhythm          @default(DAILY) @map("income_rhythm")
  incomeRhythmAnchor   DateTime?             @map("income_rhythm_anchor") @db.Date
  incomePayDays        Int[]                 @default([]) @map("income_pay_days")
  /// Customized summary cards by card id ("month", "income"), each `{ headline, grid }` of stat references
  /// (`src/lib/stats.ts`). A card left out keeps its default layout.
  summaryCards         Json?                 @map("summary_cards")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts             Account[]
  sessions             Session[]
  paymentMethods       PaymentMethod[]
  categories           Category[]
  purchases            Purchase[]
  incomeSources        IncomeSource[]
  incomeGroups         IncomeGroup[]
  incomes              Income[]
  recurringIncomes     RecurringIncome[]
  recurringPayments    RecurringPayment[]
  recurringOccurrences RecurringOccurrence[]
  statementPayments    StatementPayment[]
  savingsFunds         SavingsFund[]
  savingsMovements     SavingsMovement[]
  currencyExchanges    CurrencyExchange[]
  expenseItems         ExpenseItem[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A cash wallet, or a credit card, in one currency; purchases and bills paid with it are in that currency. Cards
/// close on `closingDay` each month and are due `paymentDays` days after closing. A cash wallet (one per currency)
/// holds money on hand: counted by hand as `cashCountCents` at `cashCountedAt`, then moved by records in its currency.
model PaymentMethod {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  kind              PaymentMethodKind
  name              String
  color             String
  currency          String             @default("MXN")
  cashCountCents    Int?               @map("cash_count_cents")
  cashCountedAt     DateTime?          @map("cash_counted_at") @db.Timestamptz(6)
  closingDay        Int?               @map("closing_day")
  paymentDays       Int?               @map("payment_days")
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases         Purchase[]
  recurringPayments RecurringPayment[]
  statementPayments StatementPayment[]

  @@index([userId])
  @@map("payment_methods")
}

/// Built-in categories have a `key` and are labelled through i18n; custom ones use `name`. `kind` says how its
/// spending counts: everyday spending (daily net, typical daily spending, averages), bills (averages only), or
/// occasional (left out of both, like one-off extras).
model Category {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  key              String?
  name             String?
  sortOrder        Int                    @default(0) @map("sort_order")
  kind             CategoryKind           @default(EVERYDAY)
  archivedAt       DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            ExpenseItem[]
  incomeDeductions IncomeGroupDeduction[]

  @@unique([userId, key])
  @@index([userId])
  @@map("categories")
}

/// Amounts are stored in centavos. A purchase is always of a reusable expense item (which sets its category);
/// `note` adds optional detail. A card purchase may be split into monthly installments.
model Purchase {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  itemId           String        @map("item_id") @db.Uuid
  paymentMethodId  String        @map("payment_method_id") @db.Uuid
  date             DateTime      @db.Date
  amountCents      Int           @map("amount_cents")
  note             String?
  installmentCount Int           @default(1) @map("installment_count")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             ExpenseItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  paymentMethod    PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([itemId])
  @@map("purchases")
}

/// A reusable expense concept, like "Gasolina" or "Renta" — the rows of the original spreadsheet. Spending is
/// tracked per item across time; the item's category groups it. `normalizedName` (trimmed, single-spaced,
/// lowercase) keeps one item per name for each user.
model ExpenseItem {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  categoryId        String             @map("category_id") @db.Uuid
  name              String
  normalizedName    String             @map("normalized_name")
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchases         Purchase[]
  recurringPayments RecurringPayment[]

  @@unique([userId, normalizedName])
  @@index([categoryId])
  @@map("expense_items")
}

/// Where income comes from. Its group, if any, decides which spending its net income is after.
model IncomeSource {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  groupId          String?           @map("group_id") @db.Uuid
  name             String
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group            IncomeGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  incomes          Income[]
  recurringIncomes RecurringIncome[]

  @@index([userId])
  @@index([groupId])
  @@map("income_sources")
}

/// Income sources grouped for a net figure, like "Rideshare" (Uber, Didi): the group's income minus spending in
/// the categories it deducts (for rideshare, Car).
model IncomeGroup {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  name       String
  archivedAt DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources    IncomeSource[]
  deductions IncomeGroupDeduction[]

  @@index([userId])
  @@map("income_groups")
}

/// A category whose spending an income group's net income is after.
model IncomeGroupDeduction {
  groupId    String      @map("group_id") @db.Uuid
  categoryId String      @map("category_id") @db.Uuid
  group      IncomeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([groupId, categoryId])
  @@index([categoryId])
  @@map("income_group_deductions")
}

/// Gross income, in centavos. Income received for a recurring income's payday links to it (`recurringIncomeId`,
/// `expectedOn` the payday), which stops that payday counting as expected.
model Income {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  sourceId          String           @map("source_id") @db.Uuid
  date              DateTime         @db.Date
  amountCents       Int              @map("amount_cents")
  /// Received in this currency, into the cash wallet of the same currency.
  currency          String           @default("MXN")
  note              String?
  recurringIncomeId String?          @map("recurring_income_id") @db.Uuid
  expectedOn        DateTime?        @map("expected_on") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  source            IncomeSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  recurringIncome   RecurringIncome? @relation(fields: [recurringIncomeId], references: [id], onDelete: SetNull)

  @@unique([recurringIncomeId, expectedOn])
  @@index([userId, date])
  @@map("incomes")
}

/// Income expected on a schedule, like a salary every two weeks: `amountCents` from `source`, in `currency`, weekly
/// or every two weeks counted from `anchor` (any payday), or on the days of the month in `payDays`; never daily.
/// Paydays count from `startsOn` (the day it was added or rescheduled, or a later first payday). Each payday stays
/// expected in its month until income is received for it.
model RecurringIncome {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  sourceId    String       @map("source_id") @db.Uuid
  amountCents Int          @map("amount_cents")
  currency    String       @default("MXN")
  rhythm      IncomeRhythm
  anchor      DateTime?    @db.Date
  payDays     Int[]        @default([]) @map("pay_days")
  startsOn    DateTime     @map("starts_on") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  incomes     Income[]

  @@index([userId])
  @@index([sourceId])
  @@map("recurring_incomes")
}

/// A bill that repeats every `intervalMonths` months from `startMonth` (first day of a month) through `endMonth`
/// when set. Its name and category come from its expense item. A variable bill (`isVariable`) is estimated from
/// recent confirmed amounts until each month's real amount is confirmed.
model RecurringPayment {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  itemId          String                @map("item_id") @db.Uuid
  paymentMethodId String                @map("payment_method_id") @db.Uuid
  amountCents     Int                   @map("amount_cents")
  isVariable      Boolean               @default(false) @map("is_variable")
  intervalMonths  Int                   @default(1) @map("interval_months")
  dayOfMonth      Int                   @map("day_of_month")
  startMonth      DateTime              @map("start_month") @db.Date
  endMonth        DateTime?             @map("end_month") @db.Date
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  item            ExpenseItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod         @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  occurrences     RecurringOccurrence[]

  @@index([userId])
  @@index([itemId])
  @@map("recurring_payments")
}

/// Per-month state of a recurring payment, stored only once the month differs from the default: a changed or
/// confirmed amount, (for cash) being marked paid, or a late switch to a card. Card-paid occurrences follow their
/// statement. For a variable bill, a stored `amountCents` is that month's confirmed amount. `chargedOn` is the day
/// a bill switched to a card after its scheduled day was really charged, which decides its statement.
model RecurringOccurrence {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  recurringPaymentId String           @map("recurring_payment_id") @db.Uuid
  month              DateTime         @db.Date
  amountCents        Int?             @map("amount_cents")
  paidAt             DateTime?        @map("paid_at") @db.Timestamptz(6)
  chargedOn          DateTime?        @map("charged_on") @db.Date
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringPayment   RecurringPayment @relation(fields: [recurringPaymentId], references: [id], onDelete: Cascade)

  @@unique([recurringPaymentId, month])
  @@index([userId, month])
  @@map("recurring_occurrences")
}

/// A card statement marked as paid. Statements themselves are derived from charges and the billing cycle;
/// `statementMonth` is the first day of the month in which the statement closes.
model StatementPayment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  statementMonth  DateTime      @map("statement_month") @db.Date
  paidAt          DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, statementMonth])
  @@index([userId])
  @@map("statement_payments")
}

enum SavingsFundKind {
  EMERGENCY
  GOAL

  @@map("savings_fund_kind")
}

/// A pot of saved money. The emergency fund's target is derived (months of average spending plus installments
/// owed); other goals have a fixed `targetCents`.
model SavingsFund {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  kind        SavingsFundKind
  name        String?
  /// Its balance and movements are in this currency, moved from and to the cash wallet of the same currency.
  currency    String            @default("MXN")
  targetCents Int?              @map("target_cents")
  coverMonths Int               @default(3) @map("cover_months")
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements   SavingsMovement[]

  @@index([userId])
  @@map("savings_funds")
}

/// Money moved into (positive) or out of (negative) a savings fund, in centavos.
model SavingsMovement {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  fundId      String      @map("fund_id") @db.Uuid
  date        DateTime    @db.Date
  amountCents Int         @map("amount_cents")
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund        SavingsFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([fundId])
  @@map("savings_movements")
}

/// Money changed from one currency to another (like selling dollars for pesos): it leaves the `from` currency's cash
/// wallet and arrives in the `to` currency's. Neither spending nor income.
model CurrencyExchange {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  fromCurrency String   @map("from_currency")
  fromCents    Int      @map("from_cents")
  toCurrency   String   @map("to_currency")
  toCents      Int      @map("to_cents")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("currency_exchanges")
}
